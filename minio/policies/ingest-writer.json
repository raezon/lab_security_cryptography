{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListerLeBucketRaw",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::raw-data"]
    },
    {
      "Sid": "DeposerDesLotsBrutsUniquementSousTransactions",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::raw-data/transactions/*"]
    }
  ]
}
