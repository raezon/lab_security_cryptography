# =============================================================================
#  DataCorp Secure — variables d'environnement du lab
#
#  1. Copier ce fichier :      cp .env.example .env
#  2. Générer des valeurs :    ./scripts/generate-env.sh   (recommandé)
#     ou remplacer chaque CHANGEME à la main.
#
#  ⚠ Le fichier .env contient des secrets d'AMORÇAGE (bootstrap) : il ne doit
#    JAMAIS être commité (voir .gitignore). Dès le TP1, ces secrets sont soit
#    rotés par Vault (vault_admin), soit remplacés par des identifiants
#    dynamiques. C'est justement l'objet du TP1.
# =============================================================================

COMPOSE_PROJECT_NAME=datacorp

# ------------------------------------------------------------------ PostgreSQL
POSTGRES_PASSWORD=CHANGEME_pg_superuser
# Compte technique utilisé par Vault (sera roté par Vault au TP1)
VAULT_DB_ADMIN_PASSWORD=CHANGEME_vault_admin
# Compte "historique" de 2019 : volontairement faible et partagé (anti-pattern TP1)
LEGACY_ETL_PASSWORD=DataCorp2019!

# ------------------------------------------------------------------ MinIO
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=CHANGEME_minio_root_min_8_chars
# Clé maître de chiffrement au repos (SSE-S3) — format  <nom>:<32 octets en base64>
# Générer :  echo "datacorp-sse-key:$(openssl rand -base64 32)"
MINIO_KMS_SECRET_KEY=datacorp-sse-key:CHANGEME_base64_32_bytes

# ------------------------------------------------------------------ RabbitMQ
RABBITMQ_ADMIN_USER=rmq-admin
RABBITMQ_ADMIN_PASSWORD=CHANGEME_rabbitmq_admin

# ------------------------------------------------------------------ Audit (TP3)
# Jeton partagé entre MinIO et le collecteur audit-sink
AUDIT_TOKEN=CHANGEME_audit_token

# ------------------------------------------------------------------ Console partagée (optionnel)
# STUDENT_MODE=1 masque les corrigés. Les URL publiques remplacent https://localhost:… dans la console.
# STUDENT_MODE=1
# VAULT_PUBLIC_URL=https://vault.exemple.fr
# MINIO_PUBLIC_URL=https://minio.exemple.fr
# RABBITMQ_PUBLIC_URL=https://rabbitmq.exemple.fr
